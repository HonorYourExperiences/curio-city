{
  "name": "curio-city",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node scripts/generate-client.mjs && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "test": "node scripts/test-prepare.mjs && DATABASE_URL=file:./test.db prisma db push --skip-generate && vitest run",
    "db:push": "node scripts/db-prepare.mjs && prisma db push",
    "postinstall": "node scripts/generate-client.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts *.ts *.mjs",
    "vercel-build": "node scripts/vercel-build.mjs",
    "db:migrate:postgres": "prisma migrate deploy --schema prisma/postgres/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.12",
    "openai": "^6.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.12",
    "prettier": "^3.9.10",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
